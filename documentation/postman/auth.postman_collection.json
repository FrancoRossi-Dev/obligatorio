{
  "info": {
    "name": "Abakus API - Auth (register / login / logout)",
    "description": "Run the whole collection with the Collection Runner. It creates a fresh advisor per run (username/email are regenerated in request 1.1), so it is safe to re-run. Requires the preloaded admin (see scripts/seed-admins.js).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "host_url",
      "value": "http://localhost:3000"
    },
    {
      "key": "base_url",
      "value": "{{host_url}}/v1"
    },
    {
      "key": "admin_username",
      "value": "Fran"
    },
    {
      "key": "admin_password",
      "value": "Admin123"
    },
    {
      "key": "advisor_username",
      "value": ""
    },
    {
      "key": "advisor_email",
      "value": ""
    },
    {
      "key": "advisor_password",
      "value": ""
    },
    {
      "key": "token",
      "value": ""
    },
    {
      "key": "revoked_token",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "1. Register",
      "item": [
        {
          "name": "1.1 Empty body -> 400",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const id = Date.now().toString(36);",
                  "pm.collectionVariables.set('advisor_username', 'advisor_' + id);",
                  "pm.collectionVariables.set('advisor_email', 'advisor_' + id + '@example.com');",
                  "pm.collectionVariables.set('advisor_password', 'Secret123');",
                  "pm.collectionVariables.set('token', '');",
                  "pm.collectionVariables.set('revoked_token', '');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 400', () => pm.response.to.have.status(400));",
                  "pm.test('Error uses the { message, details } shape', () => {",
                  "  const body = pm.response.json();",
                  "  pm.expect(body).to.have.property('message').that.is.a('string');",
                  "  pm.expect(body).to.have.property('details');",
                  "});",
                  "pm.test('Reports a problem with \"username\"', () => {",
                  "  const fields = pm.response.json().details.map((d) => d.field);",
                  "  pm.expect(fields).to.include(\"username\");",
                  "});",
                  "pm.test('Reports a problem with \"password\"', () => {",
                  "  const fields = pm.response.json().details.map((d) => d.field);",
                  "  pm.expect(fields).to.include(\"password\");",
                  "});",
                  "pm.test('Reports a problem with \"details\"', () => {",
                  "  const fields = pm.response.json().details.map((d) => d.field);",
                  "  pm.expect(fields).to.include(\"details\");",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/auth/register",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "auth",
                "register"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          }
        },
