        {
          "name": "1.7 Valid registration -> 201",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', () => pm.response.to.have.status(201));",
                  "pm.test('Returns a JWT', () => {",
                  "  const { token } = pm.response.json();",
                  "  pm.expect(token).to.be.a('string').and.match(/^[\\w-]+\\.[\\w-]+\\.[\\w-]+$/);",
                  "  pm.collectionVariables.set('token', token);",
                  "});",
                  "pm.test('Creates an advisor on the base plan', () => {",
                  "  const { user } = pm.response.json();",
                  "  pm.expect(user.username).to.eql(pm.collectionVariables.get('advisor_username'));",
                  "  pm.expect(user.role).to.eql('advisor');",
                  "  pm.expect(user.planTier).to.eql('base');",
                  "  pm.expect(user.details.email).to.eql(pm.collectionVariables.get('advisor_email'));",
                  "});",
                  "pm.test('Response never exposes the password', () => {",
                  "  pm.expect(pm.response.text()).to.not.include('\"password\"');",
                  "  pm.expect(pm.response.text()).to.not.include('$2');",
                  "});"
                ]
              }
            }
