                  "  pm.expect(body).to.have.property('details');",
                  "});",
                  "pm.test('Message is \"This session has already been closed.\"', () => pm.expect(pm.response.json().message).to.eql(\"This session has already been closed.\"));"
                ]
              }
            }
          ],
          "request": {
